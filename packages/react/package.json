{
  "name": "@reverse-http/react",
  "version": "0.1.0",
  "description": "Thin React navigation helpers for Reverse HTTP OAuth",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "react": ">=18 <20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.tsx --format esm,cjs --dts --clean --external react",
    "test": "vitest run --environment jsdom",
    "typecheck": "tsc --noEmit"
  }
}
